<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <PackageId>Fable.Ranvier.Dom</PackageId>
    <PackageId Condition="'$(RanvierTrace)' == 'true'">Fable.Ranvier.Dom.Traced</PackageId>
    <AssemblyName>Ranvier.Dom</AssemblyName>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <Version>0.1.0-alpha.28</Version>
    <Description>Fable DOM contracts sharing Ranvier.Dom's generated WebKit interface sources.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Ranvier.Dom/Generated/Dom.fs" Link="Generated/Dom.fs" />
    <Compile Include="../Ranvier.Dom/SvgPaths.fs" Link="SvgPaths.fs" />
    <Compile Include="../Ranvier.Dom/SvgViews.fs" Link="SvgViews.fs" />
    <Compile Include="BrowserSvgViews.fs" />
    <Compile Include="../Ranvier.Dom/StyleSheets.fs" Link="StyleSheets.fs" />
    <Compile Include="BrowserStyleSheets.fs" />
    <Compile Include="../Ranvier.Dom/CSS.fs" Link="CSS.fs" />
    <Compile Include="../Ranvier.Dom/CssQueries.fs" Link="CssQueries.fs" />
    <Compile Include="BrowserCssQueries.fs" />
    <Compile Include="../Ranvier.Dom/CustomProperties.fs" Link="CustomProperties.fs" />
    <Compile Include="BrowserCustomProperties.fs" />
    <Compile Include="../Ranvier.Dom/StyleValues.fs" Link="StyleValues.fs" />
    <Compile Include="BrowserStyleValues.fs" />
    <Compile Include="../Ranvier.Dom/StyleMaps.fs" Link="StyleMaps.fs" />
    <Compile Include="BrowserStyleMaps.fs" />
    <Compile Include="../Ranvier.Dom/Geometry.fs" Link="Geometry.fs" />
    <Compile Include="BrowserGeometry.fs" />
    <Compile Include="../Ranvier.Dom/TransformValues.fs" Link="TransformValues.fs" />
    <Compile Include="BrowserTransformValues.fs" />
    <Compile Include="../Ranvier.Dom/ComputedStyles.fs" Link="ComputedStyles.fs" />
    <Compile Include="BrowserComputedStyles.fs" />
    <Compile Include="../Ranvier.Dom/Timing.fs" Link="Timing.fs" />
    <Compile Include="BrowserTiming.fs" />
    <Compile Include="../Ranvier.Dom/Locales.fs" Link="Locales.fs" />
    <Compile Include="BrowserLocales.fs" />
    <Compile Include="../Ranvier.Dom/Capabilities.fs" Link="Capabilities.fs" />
    <Compile Include="BrowserCapabilities.fs" />
    <Compile Include="../Ranvier.Dom/Cancellation.fs" Link="Cancellation.fs" />
    <Compile Include="BrowserCancellation.fs" />
    <Compile Include="../Ranvier.Dom/Resources.fs" Link="Resources.fs" />
    <Compile Include="BrowserResources.fs" />
    <Compile Include="../Ranvier.Dom/EventConstruction.fs" Link="EventConstruction.fs" />
    <Compile Include="BrowserEvents.fs" />
    <Compile Include="../Ranvier.Dom/InputState.fs" Link="InputState.fs" />
    <Compile Include="BrowserInput.fs" />
    <Compile Include="../Ranvier.Dom/Viewport.fs" Link="Viewport.fs" />
    <Compile Include="BrowserViewport.fs" />
    <PackageReference Include="Fable.Core" Version="5.3.0" />
    <None Include="../Ranvier.Dom/README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
    <AssemblyMetadata Include="RanvierTrace" Value="true" />
  </ItemGroup>
  <Target Name="PackageSharedDomSource" AfterTargets="CreateStandaloneFableProject">
    <ItemGroup>
      <_PackageFiles Update="@(_PackageFiles)" Condition="'%(_PackageFiles.Extension)' == '.fs' and '%(_PackageFiles.Filename)' == 'Dom'">
        <PackagePath>fable/Generated/Dom.fs</PackagePath>
      </_PackageFiles>
      <_PackageFiles Update="@(_PackageFiles)" Condition="'%(_PackageFiles.Extension)' == '.fs' and '%(_PackageFiles.Filename)' != 'Dom'">
        <PackagePath>fable/%(_PackageFiles.Filename)%(_PackageFiles.Extension)</PackagePath>
      </_PackageFiles>
    </ItemGroup>
    <WriteLinesToFile File="$(NuspecOutputPath)fable/$(MSBuildProjectFile)" Overwrite="true"
                      Lines="&lt;Project Sdk=&quot;Microsoft.NET.Sdk&quot;&gt;;  &lt;PropertyGroup&gt;;    &lt;TargetFramework&gt;netstandard2.1&lt;/TargetFramework&gt;;    &lt;AssemblyName&gt;Ranvier.Dom&lt;/AssemblyName&gt;;  &lt;/PropertyGroup&gt;;  &lt;ItemGroup&gt;;    &lt;Compile Include=&quot;Generated/Dom.fs&quot; /&gt;;    &lt;Compile Include=&quot;SvgPaths.fs&quot; /&gt;;    &lt;Compile Include=&quot;SvgViews.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserSvgViews.fs&quot; /&gt;;    &lt;Compile Include=&quot;StyleSheets.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserStyleSheets.fs&quot; /&gt;;    &lt;Compile Include=&quot;CSS.fs&quot; /&gt;;    &lt;Compile Include=&quot;CssQueries.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserCssQueries.fs&quot; /&gt;;    &lt;Compile Include=&quot;CustomProperties.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserCustomProperties.fs&quot; /&gt;;    &lt;Compile Include=&quot;StyleValues.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserStyleValues.fs&quot; /&gt;;    &lt;Compile Include=&quot;StyleMaps.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserStyleMaps.fs&quot; /&gt;;    &lt;Compile Include=&quot;Geometry.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserGeometry.fs&quot; /&gt;;    &lt;Compile Include=&quot;TransformValues.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserTransformValues.fs&quot; /&gt;;    &lt;Compile Include=&quot;ComputedStyles.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserComputedStyles.fs&quot; /&gt;;    &lt;Compile Include=&quot;Timing.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserTiming.fs&quot; /&gt;;    &lt;Compile Include=&quot;Locales.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserLocales.fs&quot; /&gt;;    &lt;Compile Include=&quot;Capabilities.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserCapabilities.fs&quot; /&gt;;    &lt;Compile Include=&quot;Cancellation.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserCancellation.fs&quot; /&gt;;    &lt;Compile Include=&quot;Resources.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserResources.fs&quot; /&gt;;    &lt;Compile Include=&quot;EventConstruction.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserEvents.fs&quot; /&gt;;    &lt;Compile Include=&quot;InputState.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserInput.fs&quot; /&gt;;    &lt;Compile Include=&quot;Viewport.fs&quot; /&gt;;    &lt;Compile Include=&quot;BrowserViewport.fs&quot; /&gt;;  &lt;/ItemGroup&gt;;&lt;/Project&gt;" />
  </Target>
</Project>
