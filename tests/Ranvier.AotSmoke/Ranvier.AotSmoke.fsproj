<Project Sdk="Microsoft.NET.Sdk">

    <!--
    A NativeAOT app over Ranvier and Ranvier.CSharp. `dotnet publish -c Release -r linux-x64` fails on any
    IL2xxx/IL3xxx warning: both assemblies are rooted, so ILC analyses their whole public surface. The published
    binary exits non-zero when an exception or a ToString text differs from the JIT build's.
    -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <PublishAot>true</PublishAot>
        <TrimmerSingleWarn>false</TrimmerSingleWarn>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/Ranvier/Ranvier.fsproj" />
        <ProjectReference Include="../../src/Ranvier.CSharp/Ranvier.CSharp.fsproj" />
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootAssembly Include="Ranvier" />
        <TrimmerRootAssembly Include="Ranvier.CSharp" />
    </ItemGroup>

</Project>
