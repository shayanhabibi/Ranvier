<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFrameworks>net10.0;net8.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
        <GenerateProgramFile>false</GenerateProgramFile>
    </PropertyGroup>

    <!-- A traced run builds the tests as a traced consumer does: optimised Ranvier, unoptimised caller.
         An optimised caller inlines and merges sequence points, so its creation sites drift or read `?`. -->
    <PropertyGroup Condition="'$(RanvierTrace)' == 'true'">
        <Optimize>false</Optimize>
    </PropertyGroup>

    <Import Project="TestFiles.props" />

    <ItemGroup>
        <Compile Include="TestingGuide.fs" />
        <Compile Include="Main.fs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Expecto" Version="11.0.0-alpha8" />
        <PackageReference Include="Expecto.FsCheck" Version="11.0.0-alpha8-fscheck2" />
        <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.15.5" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
        <PackageReference Include="IcedTasks" Version="0.11.9" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Ranvier\Ranvier.fsproj" />
    </ItemGroup>

</Project>
