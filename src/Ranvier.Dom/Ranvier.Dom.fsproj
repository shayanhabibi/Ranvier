<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.1</TargetFrameworks>
    <PackageId>Ranvier.Dom</PackageId>
    <PackageId Condition="'$(RanvierTrace)' == 'true'">Ranvier.Dom.Traced</PackageId>
    <AssemblyName>Ranvier.Dom</AssemblyName>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <Version>0.1.0-alpha.30</Version>
    <Description>Shared DOM contracts generated from the WebKit interfaces supported by Ranvier's native UI host.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IsAotCompatible Condition="'$(TargetFramework)' == 'net10.0'">true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Generated/Dom.fs" />
    <Compile Include="SvgPaths.fs" />
    <Compile Include="SvgViews.fs" />
    <Compile Include="StyleSheets.fs" />
    <Compile Include="CSS.fs" />
    <Compile Include="CssQueries.fs" />
    <Compile Include="CustomProperties.fs" />
    <Compile Include="StyleValues.fs" />
    <Compile Include="StyleMaps.fs" />
    <Compile Include="Geometry.fs" />
    <Compile Include="TransformValues.fs" />
    <Compile Include="ComputedStyles.fs" />
    <Compile Include="Timing.fs" />
    <Compile Include="Locales.fs" />
    <Compile Include="Capabilities.fs" />
    <Compile Include="Cancellation.fs" />
    <Compile Include="Resources.fs" />
    <Compile Include="EventConstruction.fs" />
    <Compile Include="InputState.fs" />
    <Compile Include="Viewport.fs" />
    <Compile Include="FormData.fs" />
    <Compile Include="Frames.fs" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../brand/icon/ranvier-icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup Condition="'$(RanvierTrace)' == 'true'">
    <AssemblyMetadata Include="RanvierTrace" Value="true" />
  </ItemGroup>
</Project>
