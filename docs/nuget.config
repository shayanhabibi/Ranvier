<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="partas-local" value="feed" />
  </packageSources>
  <packageSourceMapping>
    <!-- Unpublished packages, committed under feed/: Partas.Nacara.Plugins.Solid (Partas.Nacara.Plugins
         44d0693), and Partas.Solid 3 for the live examples it compiles (Partas.Solid e08ad85). -->
    <packageSource key="partas-local">
      <package pattern="Partas.Nacara.Plugins.Solid" />
      <package pattern="Partas.Solid" />
      <package pattern="Partas.Solid.FablePlugin" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
