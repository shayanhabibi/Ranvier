<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RanvierTrace>false</RanvierTrace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <FuncUIRoot Condition="'$(FuncUIRoot)' == ''">$(MSBuildThisFileDirectory)../../../Avalonia.FuncUI</FuncUIRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Views.fs" />
    <Compile Include="Runners.fs" />
    <Compile Include="Verification.fs" />
    <Compile Include="Measurement.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Elmish" Version="5.0.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.0" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.0" />
    <ProjectReference Include="Workload.Model.fsproj" />
    <ProjectReference Include="$(FuncUIRoot)/src/Avalonia.FuncUI/Avalonia.FuncUI.fsproj" />
    <ProjectReference Include="../../src/Ranvier.Elmish/Ranvier.Elmish.fsproj" AdditionalProperties="RanvierTrace=false" />
  </ItemGroup>
</Project>
